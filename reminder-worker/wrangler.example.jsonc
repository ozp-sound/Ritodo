{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ritodo-reminders",
  "main": "index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ritodo-reminders",
    "database_id": "REPLACE_WITH_YOUR_REMINDER_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": { "APP_URL": "https://REPLACE_WITH_YOUR_RITODO_URL/" }
}
